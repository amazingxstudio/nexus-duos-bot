# Nexus Duos Backend — Environment Variables Template
# Copy this to .env for local development and fill in real values.
# NEVER commit the actual .env file (it's in .gitignore).
#
# On Render: paste this whole block into Environment tab using
# "Add from .env" button, then edit each value to the real one.

NODE_ENV=production
PORT=4000

# Your Vercel frontend URL (use http://localhost:3000 for local dev)
CLIENT_URL=https://your-app.vercel.app
CORS_ORIGINS=https://your-app.vercel.app

# PostgreSQL — from Render dashboard: your Postgres instance → "Internal Database URL"
DATABASE_URL=postgresql://user:password@host/dbname

# From @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456789:AAAA-your-real-bot-token-here
TELEGRAM_WEBAPP_URL=https://your-app.vercel.app

# Long random string — generate your own, never reuse this example
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_MINUTES=10080
TELEGRAM_AUTH_MAX_AGE=86400

RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=120
